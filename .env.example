# Salin ke .env lalu sesuaikan.  JANGAN commit .env.

# --- Identitas ---
NAMA_PERUSAHAAN="PT Dhanarmas"
NAMA_BOT="Asisten HRD"

# --- Mode jawaban ---
# draft = jawaban ditahan, HRD meninjau lalu mengirim  <-- MULAI DARI SINI
# auto  = jawaban langsung ke karyawan
ANSWER_MODE=draft

# --- Penyedia LLM ---
# groq      = PILIHAN PROYEK INI. Model terbuka, ada tier gratis.
# mock      = tanpa jaringan sama sekali; bawaan yang di-commit supaya klon
#             baru tetap jalan tanpa kunci apa pun
# hermes    = endpoint OpenAI-compatible milik sendiri (vLLM), untuk on-prem
# anthropic = Claude API; opsional, kalau kepatuhan sitasi perlu lebih tinggi
LLM_PROVIDER=mock

# Diisi kalau LLM_PROVIDER=groq — kunci gratis di https://console.groq.com/keys
GROQ_API_KEY=
# Nama model Groq berubah dan yang lama dihentikan. Jangan percaya nilai di bawah
# ini; jalankan dulu:  python3 scripts/cek_provider.py --daftar-model
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Diisi kalau LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low cukup untuk tanya-jawab kebijakan; naikkan hanya kalau eval menunjukkan ada ruang
ANTHROPIC_EFFORT=low

# Diisi kalau LLM_PROVIDER=hermes
HERMES_BASE_URL=http://localhost:8000/v1
HERMES_MODEL=NousResearch/Hermes-3-Llama-3.1-8B
HERMES_API_KEY=not-needed

MAX_OUTPUT_TOKENS=1500
HISTORY_TURNS=6

# --- Konsol HRD ---
# WAJIB diganti. Ganti dengan SSO sebelum dipakai luas.
HRD_CONSOLE_TOKEN=ganti-token-ini

# Ambang peringatan ukuran korpus, dalam token perkiraan. Sesuaikan dengan
# context window model yang dipakai, sisakan ruang untuk riwayat dan jawaban:
#   Claude (1 juta token)           -> 400000
#   Llama 3.3 70B di Groq (128rb)   -> 60000
#   model 8B (8rb-32rb)             -> 6000
# Cek ukuran promptmu:  python3 scripts/cek_provider.py --ukur-korpus
AMBANG_TOKEN_KORPUS=400000

# --- Pengaman korpus ---
# true = izinkan mode auto walau korpus masih dokumen contoh (hanya untuk demo)
ALLOW_SAMPLE_DOCS_IN_AUTO=false

# --- Kontak eskalasi ---
KONTAK_HRD="HRD — ext. 100 / hrd@contoh.co.id"
KONTAK_KRISIS="Layanan SEJIWA Kemenkes: 119 ext. 8 (mohon HRD verifikasi & sesuaikan)"

# --- WhatsApp (opsional, untuk onboarding terjadwal) ---
# Tanpa ini, scheduler jalan sebagai latihan kering ke log.
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
